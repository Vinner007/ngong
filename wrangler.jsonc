{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ngong",
  "account_id": "9380e34ec70e3810a04d4936bca2659c",
  // Custom entry: wraps the OpenNext handler and adds the RoomDO + API routes.
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ngong"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "RoomDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }],
  "ai": { "binding": "AI" },
  // Per-IP limits. Campus Wi-Fi puts a whole lecture hall behind one IP,
  // so these are generous; the strict per-device limits live inside RoomDO.
  "ratelimits": [
    { "name": "CREATE_ROOM_LIMITER", "namespace_id": "4101", "simple": { "limit": 5, "period": 60 } },
    { "name": "READ_LIMITER", "namespace_id": "4102", "simple": { "limit": 600, "period": 60 } },
    { "name": "WRITE_LIMITER", "namespace_id": "4103", "simple": { "limit": 300, "period": 60 } }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  },
  // Cloudflare creates the DNS record and certificate for this subdomain on deploy.
  // thanachart.dev itself belongs to the portfolio site, so only the subdomain is used here.
  "routes": [{ "pattern": "ngong.thanachart.dev", "custom_domain": true }],
  // The workers.dev address stays on as a fallback link.
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  }
}
